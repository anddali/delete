#############################################
# ENVIRONMENT
#############################################
ENVIRONMENT=development  # development, staging, production

#############################################
# DATABASE CONFIGURATION
#############################################
# Primary database (read/write)
DATABASE_URL=postgresql+asyncpg://raguser:ragpassword@postgres:5432/ragdb

# Read replica (optional, for query API)
DATABASE_READ_REPLICA_URL=postgresql+asyncpg://raguser:ragpassword@postgres:5432/ragdb

# Database pool settings
DATABASE_POOL_SIZE=25
DATABASE_MAX_OVERFLOW=10

#############################################
# REDIS CONFIGURATION
#############################################
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=50

#############################################
# SECURITY & AUTHENTICATION
#############################################
# JWT Configuration
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Credential encryption (32 characters)
CREDENTIAL_ENCRYPTION_KEY=change-me-32-characters-exactly!

#############################################
# OPENAI CONFIGURATION
#############################################
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_ORG_ID=org-your-org-id
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

#############################################
# AWS CONFIGURATION
#############################################
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# S3 Configuration
S3_BUCKET=rag-uploads
S3_ENDPOINT=http://minio:9000  # Leave empty for AWS S3, set for MinIO in dev

#############################################
# CELERY CONFIGURATION
#############################################
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

#############################################
# APPLICATION SETTINGS
#############################################
# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8001

# API URLs
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_APP_NAME=RAG Knowledge Admin

#############################################
# PERFORMANCE TUNING
#############################################
# Ingestion settings
MAX_WORKERS=5
BATCH_SIZE=100
EMBEDDING_BATCH_SIZE=100

# Caching settings (seconds)
QUERY_CACHE_TTL=900          # 15 minutes
EMBEDDING_CACHE_TTL=3600     # 1 hour
TOKEN_CACHE_TTL=300          # 5 minutes

# Search settings
SEARCH_TIMEOUT_SECONDS=5
MAX_RESULTS_PER_QUERY=100

#############################################
# MONITORING & LOGGING
#############################################
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Sentry (optional)
SENTRY_DSN=

# Prometheus (optional)
METRICS_ENABLED=true

# Grafana (optional)
GRAFANA_ADMIN_PASSWORD=admin

#############################################
# RATE LIMITING DEFAULTS
#############################################
DEFAULT_RATE_LIMIT_PER_MINUTE=100
DEFAULT_RATE_LIMIT_PER_DAY=10000

#############################################
# DATA RETENTION
#############################################
DOCUMENT_RETENTION_DAYS=  # Leave empty for no limit
AUDIT_LOG_RETENTION_DAYS=90
JOB_LOG_RETENTION_DAYS=30
QUERY_LOG_RETENTION_DAYS=30
